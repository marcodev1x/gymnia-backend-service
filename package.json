{
  "name": "academIA-backend",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "license": "MIT",
  "description": "Backend for the AcademIA platform",
  "author": "Z1 Group LTDA.",
  "bin": {
    "eslint": "./node_modules/.bin/eslint"
  },
  "type": "commonjs",
  "_moduleAliases": {
    "~": "./dist/src"
  },
  "scripts": {
    "build": "tsc",
    "start:build": "node -r tsconfig-paths/register -r module-alias/register dist/src/index.js",
    "start:dev": "tsx --watch ./src/index.ts",
    "test:dev": "jest --config jest.config.ts",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/cors": "2.8.19",
    "@types/eslint": "9.6.1",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/module-alias": "2.0.4",
    "@types/node": "24.0.10",
    "@typescript-eslint/eslint-plugin": "8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "9.30.1",
    "eslint-config-airbnb-base": "14.2.1",
    "eslint-config-airbnb-typescript": "12.3.1",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "2.4.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-import-helpers": "2.0.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-unused-imports": "4.1.4",
    "jest": "30.0.4",
    "jest-extended": "6.0.0",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.36.0"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "17.1.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "knex": "3.1.0",
    "module-alias": "2.2.3",
    "objection": "3.1.5",
    "pg": "8.16.3",
    "tsconfig-paths": "4.2.0",
    "zod": "3.25.75"
  }
}
